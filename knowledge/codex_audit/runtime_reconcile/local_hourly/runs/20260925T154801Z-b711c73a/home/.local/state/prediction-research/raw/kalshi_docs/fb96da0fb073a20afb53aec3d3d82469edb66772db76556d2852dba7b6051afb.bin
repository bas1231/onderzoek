position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px" data-component-part="scroll-area" id="sidebar-content" class="min-w-0 absolute! inset-0 z-10"><div role="presentation" data-id="base-ui-_R_2tbsnlhjiuqsnpfiutb_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] pr-8 pb-10 base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-0! w-full"><div class="relative lg:text-sm lg:leading-6"><div class="sticky top-0 h-8 pointer-events-none z-10 bg-linear-to-b from-background-light dark:from-background-dark"></div><div id="navigation-items"><ul class="sidebar-group"></ul><script>(function () {
  try {
    if (window.__mintlifyInitialSidebarScrollDone) return;
    window.__mintlifyInitialSidebarScrollDone = true;

    var path = (window.location.pathname || '/').split('#')[0].split('?')[0];
    if (path.endsWith('/index')) path = path.slice(0, -6);
    else if (path === 'index') path = '';

    var candidates = [];
    if (path) candidates.push(path);
    if (path.startsWith('/')) candidates.push(path.slice(1));
    else candidates.push('/' + path);

    var item = null;
    for (var i = 0; i < candidates.length && !item; i++) {
      var matches = document.querySelectorAll('[id="' + candidates[i].replace(/"/g, '\\"') + '"]');
      for (var j = 0; j < matches.length; j++) {
        if (matches[j].closest('#sidebar, #sidebar-content')) {
          item = matches[j];
          break;
        }
      }
    }
    if (!item) return;

    var parent = item.closest('[data-component-part="scroll-area-viewport"]');
    if (!parent) {
      parent = item.parentElement;
      while (parent) {
        var style = getComputedStyle(parent);
        if (style.overflowY === 'auto' || style.overflowY === 'scroll') break;
        parent = parent.parentElement;
      }
    }
    if (!parent) return;

    var parentRect = parent.getBoundingClientRect();
    var itemRect = item.getBoundingClientRect();
    if (itemRect.top >= parentRect.top && itemRect.bottom <= parentRect.bottom) return;

    var itemTopRelative = itemRect.top - parentRect.top + parent.scrollTop;
    parent.scrollTop = itemTopRelative - parentRect.height / 2 + itemRect.height / 2;
  } catch (e) {}
})();</script></div></div></div></div></div></nav><main id="content-container" class="lg:flex-1 lg:min-w-0"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://docs.kalshi.com/#organization","name":"API Documentation","url":"https://docs.kalshi.com","logo":{"@type":"ImageObject","url":"https://mintcdn.com/kalshi-b198743e/koRHzlv9fsyF-jSm/logo-light.svg?fit=max&auto=format&n=koRHzlv9fsyF-jSm&q=85&s=bac849e081bbb1881bb945ea3e0464a8"}},{"@type":"WebSite","@id":"https://docs.kalshi.com#website","name":"API Documentation","url":"https://docs.kalshi.com","publisher":{"@id":"https://docs.kalshi.com/#organization"}},{"@type":"WebPage","@id":"https://docs.kalshi.com/welcome#webpage","url":"https://docs.kalshi.com/welcome","name":"Introduction","description":"Welcome to the Kalshi API documentation","dateModified":"2026-06-25T16:39:29.738Z","isPartOf":{"@id":"https://docs.kalshi.com#website"}},{"@type":["Article","TechArticle"],"@id":"https://docs.kalshi.com/welcome#article","headline":"Introduction","name":"Introduction","description":"Welcome to the Kalshi API documentation","url":"https://docs.kalshi.com/welcome","mainEntityOfPage":{"@id":"https://docs.kalshi.com/welcome#webpage"},"dateModified":"2026-06-25T16:39:29.738Z","publisher":{"@id":"https://docs.kalshi.com/#organization"},"isPartOf":{"@id":"https://docs.kalshi.com#website"}}]}</script><script>document.documentElement.setAttribute('data-page-mode', "custom");</script><span class="fixed inset-0 bg-background-light dark:bg-background-dark -z-10 pointer-events-none" id="background-color"></span><style data-custom-css-index="0" data-custom-css-path="style.css">/* Keep /changelog in the Changelog tab without rendering a redundant sidebar row. */
#navigation-items li[id="/changelog"] {
  display: none;
}

.docs-home-hero {
  position: relative;
  width: 100%;
  height: 24rem;
  overflow: hidden;
  margin-top: -1px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.docs-home-hero-bg {
  position: absolute;
  inset: 0;
  height: 24rem;
  background-size: 100%;
  background-position: center;
  background-repeat: no-repeat;
}

.docs-home-hero-bg-light {
  background-image: url("https://mintlify-assets.b-cdn.net/kalshi-bg.svg");
}

.docs-home-hero-bg-dark {
  display: none;
  background-image: url("https://mintlify-assets.b-cdn.net/kalshi-dark-bg.svg");
}

.dark .docs-home-hero-bg-light {
  display: none;
}

.dark .docs-home-hero-bg-dark {
  display: block;
}

.docs-home-hero-content {
  position: absolute;
  width: min(45rem, calc(100% - 2rem));
  padding: 0 1rem;
  text-align: center;
  color: #000;
}

.dark .docs-home-hero-content {
  color: #fff;
}

.docs-home-hero-title {
  margin: 0;
  font-family: Inter, sans-serif;
  font-size: 36px;
  font-weight: 500;
  line-height: 44px;
}

.docs-home-hero-subtitle {
  margin-top: 1rem;
  font-size: 18px;
  font-weight: 400;
  opacity: 0.6;
}

.docs-home-hero-agreement {
  margin-top: 0.75rem;
  font-size: 14px;
  font-weight: 400;
}

.docs-home-hero-agreement span {
  opacity: 0.6;
}

.docs-home-hero-link {
  color: #00B67A;
  text-decoration: underline;
}

html.dark .docs-home-hero-link {
  color: #00DD94;
}

.docs-home-content {
  max-width: 70rem;
  margin: 4rem auto 8rem;
  padding: 0 1.25rem;
}

.docs-home-section-title {
  margin-top: 3.25rem;
  margin-bottom: 1.25rem;
  font-size: 1.75rem;
  font-weight: 650;
  line-height: 2.25rem;
}

.docs-home-section-title:first-child {
