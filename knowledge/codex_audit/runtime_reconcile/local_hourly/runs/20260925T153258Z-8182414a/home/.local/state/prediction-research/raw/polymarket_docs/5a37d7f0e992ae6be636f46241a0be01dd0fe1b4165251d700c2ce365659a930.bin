    if (!parent) {
      parent = item.parentElement;
      while (parent) {
        var style = getComputedStyle(parent);
        if (style.overflowY === 'auto' || style.overflowY === 'scroll') break;
        parent = parent.parentElement;
      }
    }
    if (!parent) return;

    var parentRect = parent.getBoundingClientRect();
    var itemRect = item.getBoundingClientRect();
    if (itemRect.top >= parentRect.top && itemRect.bottom <= parentRect.bottom) return;

    var itemTopRelative = itemRect.top - parentRect.top + parent.scrollTop;
    parent.scrollTop = itemTopRelative - parentRect.height / 2 + itemRect.height / 2;
  } catch (e) {}
})();</script></div></div></div></div></nav><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://docs.polymarket.com/#organization","name":"Polymarket Documentation","url":"https://docs.polymarket.com","logo":{"@type":"ImageObject","url":"https://mintcdn.com/polymarket-292d1b1b/ZibMe6Tli_amZald/logo/light.svg?fit=max&auto=format&n=ZibMe6Tli_amZald&q=85&s=9f9bd559f02181495794661ef6426c0f"}},{"@type":"WebSite","@id":"https://docs.polymarket.com#website","name":"Polymarket Documentation","url":"https://docs.polymarket.com","publisher":{"@id":"https://docs.polymarket.com/#organization"}},{"@type":"WebPage","@id":"https://docs.polymarket.com/#webpage","url":"https://docs.polymarket.com/","name":"Overview","description":"Build on the world's largest prediction market. Trade, integrate, and access real-time market data with the Polymarket API.","dateModified":"2026-07-23T13:48:30.462Z","isPartOf":{"@id":"https://docs.polymarket.com#website"},"breadcrumb":{"@id":"https://docs.polymarket.com/#breadcrumb"}},{"@type":"BreadcrumbList","@id":"https://docs.polymarket.com/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Getting Started","item":"https://docs.polymarket.com/index"},{"@type":"ListItem","position":2,"name":"Overview","item":"https://docs.polymarket.com/"}]},{"@type":["Article","TechArticle"],"@id":"https://docs.polymarket.com/#article","headline":"Overview","name":"Overview","description":"Build on the world's largest prediction market. Trade, integrate, and access real-time market data with the Polymarket API.","url":"https://docs.polymarket.com/","mainEntityOfPage":{"@id":"https://docs.polymarket.com/#webpage"},"dateModified":"2026-07-23T13:48:30.462Z","publisher":{"@id":"https://docs.polymarket.com/#organization"},"isPartOf":{"@id":"https://docs.polymarket.com#website"}}]}</script><script>document.documentElement.setAttribute('data-page-mode', "frame");</script><span class="fixe