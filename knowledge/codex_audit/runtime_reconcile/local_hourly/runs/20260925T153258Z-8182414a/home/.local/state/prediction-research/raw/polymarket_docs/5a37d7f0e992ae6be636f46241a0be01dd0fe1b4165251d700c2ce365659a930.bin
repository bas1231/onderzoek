}

.tab-container [data-component-part="tabs-list"] {
  margin-bottom: 0;
  padding-inline: 1rem;
  background-color: rgb(var(--gray-50));
  border-bottom-color: rgb(var(--gray-200));
}
html.dark .tab-container [data-component-part="tabs-list"] {
  background-color: rgb(var(--gray-950));
  border-bottom-color: rgb(var(--gray-800));
}

