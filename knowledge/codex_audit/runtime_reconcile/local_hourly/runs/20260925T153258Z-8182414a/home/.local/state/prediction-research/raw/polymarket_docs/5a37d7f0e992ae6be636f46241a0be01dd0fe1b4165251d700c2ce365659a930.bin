/* Tabs: visible border around the tabbed region */
.tab-container {
  border: 1px solid rgb(var(--gray-200));
  border-radius: 0.75rem;
  overflow: hidden;
  background-color: rgb(var(--background-light));
}
html.dark .tab-container {
  border-color: rgb(var(--gray-800));
