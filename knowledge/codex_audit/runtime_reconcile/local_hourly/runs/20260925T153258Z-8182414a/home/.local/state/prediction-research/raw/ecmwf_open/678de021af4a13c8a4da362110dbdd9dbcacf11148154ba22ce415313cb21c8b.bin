<article data-history-node-id="28188" class="node node--type-numerical-product node--promoted node--sticky node--view-mode-full clearfix">

  <div class="pull-right">
    <fieldset class="url_licence js-form-item form-item js-form-wrapper form-wrapper" id="url-licence">
