additional-strikes"},{"id":"16024194","title":"Request to Settle Market","url":"https://help.kalshi.com/en/articles/13823835-request-to-settle-market"},{"id":"16024195","title":"How are prices determined?","url":"https://help.kalshi.com/en/articles/13823836-how-are-prices-determined"}],"subcollections":[]},{"id":"18616615","name":"Popular Markets","url":"https://help.kalshi.com/en/collections/18616615-popular-markets","iconUrl":null,"iconContentType":null,"iconPreColored":false,"articles":[{"id":"16024196","title":"Weather Markets","url":"https://help.kalshi.com/en/articles/13823837-weather-markets"},{"id":"16024197","title":"Crypto Markets","url":"https://help.kalshi.com/en/articles/13823838-crypto-markets"},{"id":"16024198","title":"Spotify Markets","url":"https://help.kalshi.com/en/articles/13823839-spotify-markets"},{"id":"16024199","title":"Netflix Markets","url":"https://help.kalshi.com/en/articles/13823840-netflix-markets"},{"id":"16024200","title":"Top App Markets","url":"https://help.kalshi.com/en/articles/13823841-top-app-markets"}],"subcollections":[]}]},{"id":"18616616","name":"Portfolio \u0026 Tools","url":"https://help.kalshi.com/en/collections/18616616-portfolio-tools","iconUrl":"https://intercom.help/kalshi-37fb2688dc4d/assets/svg/icon:charts-chart-bar","iconContentType":"image/svg+xml","iconPreColored":false,"articles":[{"id":"16024201","title":"Finding Markets","url":"https://help.kalshi.com/en/articles/13823842-finding-markets"},{"id":"16024203","title":"Portfolio","url":"https://help.kalshi.com/en/articles/13823844-portfolio"},{"id":"16024204","title":"Cash","url":"https://help.kalshi.com/en/articles/13823845-cash"},{"id":"16024207","title":"APY on Kalshi","url":"https://help.kalshi.com/en/articles/13823847-apy-on-kalshi"},{"id":"17634774","title":"How can I update my username or profile picture on Kalshi?","url":"https://help.kalshi.com/en/articles/14982997-how-can-i-update-my-username-or-profile-picture-on-kalshi"}],"subcollections":[]},{"id":"18616617","name":"Taxes \u0026 Documents","url":"https://help.kalshi.com/en/collections/18616617-taxes-documents","iconUrl":"https://intercom.help/kalshi-37fb2688dc4d/assets/svg/icon:ff-document-check","iconContentType":"image/svg+xml","iconPreColored":false,"articles":[{"id":"16024208","title":"Trading History","url":"https://help.kalshi.com/en/articles/13823848-trading-history"},{"id":"16024209","title":"What Tax Documentation Does Kalshi Provide?","url":"https://help.kalshi.com/en/articles/13823849-what-tax-documentation-does-kalshi-provide"},{"id":"19342685","title":"How to Add Your Social Security Number","url":"https://help.kalshi.com/en/articles/16083491-how-to-add-your-social-security-number"}],"subcollections":[]},{"id":"18616618","name":"Programs \u0026 Promotions","url":"https://help.kalshi.com/en/collections/18616618-programs-promotions","iconUrl":"https://intercom.help/kalshi-37fb2688dc4d/assets/svg/icon:other-gift","iconContentType":"image/svg+xml","iconPreColored":false,"articles":[{"id":"16024210","title":"What is the Kalshi Volume Incentive Program?","url":"https://help.kalshi.com/en/articles/13823850-what-is-the-kalshi-volume-incentive-program"},{"id":"16024211","title":"Liquidity Incentive Program","url":"https://help.kalshi.com/en/articles/13823851-liquidity-incentive-program"},{"id":"16024212","title":"Market Bug Bounty Program","url":"https://help.kalshi.com/en/articles/13823852-market-bug-bounty-program"},{"id":"16024213","title":"App and Website Bug Bounty Program","url":"https://help.kalshi.com/en/articles/13823853-app-and-website-bug-bounty-program"},{"id":"18320791","title":"Liquidity Provider Program","url":"https://help.kalshi.com/en/articles/15410219-liquidity-provider-program"},{"id":"19332471","title":"Liquidity and Volume Incentive Programs: Where to Find Them","url":"https://help.kalshi.com/en/articles/16076644-liquidity-and-volume-incentive-programs-where-to-find-them"},{"id":"20854627","title":"Sports Prop Combo Market Component Legs Liquidity Incentive Program","url":"https://help.kalshi.com/en/articles/17184676-sports-prop-combo-market-component-legs-liquidity-incentive-program"}],"subcollections":[]},{"id":"18616620","name":"API \u0026 Developers","url":"https://help.kalshi.com/en/collections/18616620-api-developers","iconUrl":"https://intercom.help/kalshi-37fb2688dc4d/assets/svg/icon:sft-command-line","iconContentType":"image/svg+xml","iconPreColored":false,"articles":[{"id":"16024214","title":"Kalshi API","url":"https://help.kalshi.com/en/articles/13823854-kalshi-api"}],"subcollections":[]},{"id":"18616623","name":"Support","url":"https://help.kalshi.com/en/collections/18616623-support","iconUrl":"https://intercom.help/kalshi-37fb2688dc4d/assets/svg/icon:people-chat-gets-chat-bubble-bottom-center-text","iconContentType":"image/svg+xml","iconPreColored":false,"articles":[{"id":"16024215","title":"Contact Kalshi Support","url":"https://help.kalshi.com/en/articles/13823855-contact-kalshi-support"},{"id":"16024216","title":"Connect with Us","url":"https://help.kalshi.com/en/articles/13823856-connect-with-us"},{"id":"16024217","title":"Kalshi Merch","url":"https://help.kalshi.com/en/articles/13823857-kalshi-merch"}],"subcollections":[]},{"id":"19685710","name":"Kalshi Social","url":"https://help.kalshi.com/en/collections/19685710-kalshi-social","iconUrl":"https://intercom.help/kalshi-37fb2688dc4d/assets/svg/icon:book-bookmark","iconContentType":"image/svg+xml","iconPreColored":false,"articles":[{"id":"19032818","title":"How do I post, comment, and react on Kalshi Social?","url":"https://help.kalshi.com/en/articles/15891130-how-do-i-post-comment-and-react-on-kalshi-social"},{"id":"19032819","title":"Kalshi Social Community Guidelines","url":"https://help.kalshi.com/en/articles/15891131-kalshi-social-community-guidelines"},{"id":"19032820","title":"How do I report or block someone on Kalshi Social?","url":"https://help.kalshi.com/en/articles/15891132-how-do-i-report-or-block-someone-on-kalshi-social"},{"id":"19032821","title":"What is Live Chat on Kalshi Social?","url":"https://help.kalshi.com/en/articles/15891133-what-is-live-chat-on-kalshi-social"},{"id":"16024202","title":"What is Kalshi Social?","url":"https://help.kalshi.com/en/articles/13823843-what-is-kalshi-social"},{"id":"16024127","title":"How do I edit my Kalshi Social profile?","url":"https://help.kalshi.com/en/articles/13823773-how-do-i-edit-my-kalshi-social-profile"}],"subcollections":[]}]},"articleContent":{"articleId":"13823837","author":null,"blocks":[{"type":"heading","text":"How do weather markets work?","idAttribute":"h_3a878115eb"},{"type":"paragraph","text":"Kalshi offers a wide variety of weather-related markets that allow users to trade contracts based on temperature movements or precipitation amounts in specific cities, from New York City to Los Angeles. Traders can take positions on whether a city will reach a certain high temperature or fall within a particular range. Each weather market names its official settlement source in its market rules. Daily high/low temperature markets settle based on the final climate report issued by the National Weather Service (NWS), typically released the following morning. Hourly temperature markets settle on readings from \u003ca href=\"https://weather.com/kalshi\" target=\"_blank\" rel=\"nofollow noopener noreferrer\"\u003eThe Weather Company\u003c/a\u003e. Always check the specific market’s rules for its source.","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"heading","text":"How Do I Trade on Weather Markets?","idAttribute":"h_13a85c056f"},{"type":"paragraph","text":"Kalshi creates a prediction market around a specific temperature threshold for a given location. For example: “Highest temperature in Chicago on April 15, 2025?”\u003cbr\u003e​\u003cbr\u003eContract prices for temperature ranges may shift as new weather data (e.g., forecasts, model runs, satellite images, observations) becomes available.","class":"no-margin"},{"type":"callout","content":[{"type":"paragraph","text":"\u003cb\u003eNote:\u003c/b\u003e Not all weather data is the same. Apps like AccuWeather, iOS Weather, or Google Weather may be useful for guidance but do not determine contract outcomes. The only source used for settlement is the one named in the market’s rules - the NWS Daily Climate Report for daily temperature markets, or The Weather Company for hourly temperature markets.","class":"no-margin"}],"style":{"backgroundColor":"#feedaf80","borderColor":"#fbc91633"}},{"type":"subheading3","text":"Daily Temperature Markets","idAttribute":"h_e6219cfd03"},{"type":"paragraph","text":"Daily weather markets are typically ranges: contracts resolve on the day’s highest (or lowest) temperature at the listed station, offered as a set of temperature ranges plus “or above” / “or below” levels.\u003cbr\u003e","class":"no-margin"},{"type":"paragraph","text":"These markets settle the next morning based on the high temperature recorded in the final NWS Daily Climate Report. Market determination may be delayed in the rare instances of a) a high temperature is not consistent with 6-hr or 24-hr highs reported by METAR or b) the final NWS Climate Report high temperature value is lower than previous preliminary report.\u003cbr\u003e​","class":"no-margin"},{"type":"subheading3","text":"Hourly Temperature Markets","idAttribute":"h_e3c3987fb7"},{"type":"paragraph","text":"Some temperature markets are hourly - the market title names an exact time, for example “Chicago temperature at 5 PM EDT.” These markets are also directional: each contract resolves on whether the temperature at that time is above or below a specific level, rather than within a range. They settle on the temperature at that exact time as reported by The Weather Company for the station coordinates named in the market rules (for example, KORD for Chicago).\u003cbr\u003e​","class":"no-margin"},{"type":"paragraph","text":"For these markets, The Weather Company’s reported value is official and final. NWS Climatological Reports, Google Weather, and other services may be useful references, but they are not authoritative for settlement. Preliminary Weather Company readings may differ from the final reported value due to rounding and conversion, so use caution when interpreting preliminary readings.\u003cbr\u003e​","class":"no-margin"},{"type":"paragraph","text":"Settlement processes approximately 25-35 minutes after the market closes to ensure accurate data retrieval from the official source - a short delay after close is normal. Historical readings and market data are available at \u003ca href=\"https://weather.com/kalshi\" target=\"_blank\" rel=\"nofollow noopener noreferrer\"\u003eweather.com/kalshi\u003c/a\u003e.\u003cbr\u003e​","class":"no-margin"},{"type":"subheading3","text":"Daylight Savings Time","idAttribute":"h_43c2973c54"},{"type":"paragraph","text":"The NWS Climate Reports (used for daily temperature markets) use local standard time when reporting daily high temperatures. This means that during Daylight Saving Time, the high temperature will be recorded between 1:00 AM and 12:59 AM local time the following day - not based on the standard midnight-to-midnight range.","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"subheading3","text":"Finding Kalshi market's relevant source information","idAttribute":"h_b566fad15f"},{"type":"image","url":"https://kalshi-62603e0948a4.intercom-attachments-7.com/i/o/wwha9iqh/2091381381/2b7de06f658363bda4a17396305d/spaces-2FmflMk4KOqMWpaeqpjOT5-2Fuploads-2FWcqIM6bL64oFXbx92woU-2Fimage-20%285%29.png-alt%3Dmedia-token%3D3974bec1-7307-4787-b609-cbf9ecddb0bd?expires=1790406000\u0026signature=e918a12466cf1f2776a79bf57757b63be2fd3dead12eda04990661260b330763\u0026req=diAuF8p2nIJXWPMW1HO4zYAoVEgnmd%2Fi9Ma1Gk%2BZzvbRn58G5OgY7kCAygY6%0A4%2BCyABDMpaNXN%2B%2Fscws%3D%0A"},{"type":"paragraph","text":"\u003ci\u003eKalshi market for highest temp in NYC on March 17th, 2025.\u003c/i\u003e","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"paragraph","text":"Here is an example of a weather market and how to find the relevant outcome (high temp). This example is for Mar 17, 2025 which was 59 degrees F. Above, you can see the Kalshi market and its determined outcome. Below, is the source data from the outcome verification source (linked in market rules).","class":"no-margin"},{"type":"paragraph","text":" ","class":"no-margin"},{"type":"image","url":"https://kalshi-62603e0948a4.intercom-attachments-7.com/i/o/wwha9iqh/2091381393/6570c24f58bbade41b4961d5b133/spaces-2FmflMk4KOqMWpaeqpjOT5-2Fuploads-2Frl0VBfS51RV1dXDQBfbu-2FUntitled-20drawing-20%283%29.jpg-alt%3Dmedia-token%3De23e725d-23dd-4bb8-8a38-895fc972308a?expires=1790406000\u0026signature=006fa7741c245cb75988100831b26f6667788c0b99aeee77a466d5f7d20745fe\u0026req=diAuF8p2nIJWWvMW1HO4zcK36iCgz7oN%2B8It%2FPAV8AtvJiHmDex3k8X2G96R%0AB2iZabwPAV6lri80g0c%3D%0A"},{"type":"paragraph","text":"\u003ci\u003e*Make sure you are viewing the temperature from the same date as the Kalshi market.\u003c/i\u003e\u003cbr\u003e​","class":"no-margin"},{"type":"paragraph","text":"For hourly temperature markets, the outcome source data is available at \u003ca href=\"https://weather.com/kalshi\" target=\"_blank\" rel=\"nofollow noopener noreferrer\"\u003eweather.com/kalshi\u003c/a\u003e.","class":"no-margin"}],"collectionId":"18616615","description":"","id":"16024196","lastUpdated":"Updated over 2 months ago","lastUpdatedDate":"2026-07-22T21:48:23Z","markdown":null,"relatedArticles":[{"title":"What is Kalshi?","url":"https://help.kalshi.com/en/articles/13823763-what-is-kalshi"},{"title":"What are prediction markets?","url":"https://help.kalshi.com/en/articles/13823766-what-are-prediction-markets"},{"title":"Why Kalshi contracts over other asset classes?","url":"https://help.kalshi.com/en/articles/13823769-why-kalshi-contracts-over-other-asset-classes"},{"title":"Market Outcomes","url":"https://help.kalshi.com/en/articles/13823826-market-outcomes"},{"title":"Spotify Markets","url":"https://help.kalshi.com/en/articles/13823839-spotify-markets"}],"targetUserType":"everyone","title":"Weather Markets","showTableOfContents":true,"synced":false,"isStandaloneApp":false,"publiclyFetchableMarkdown":true},"breadcrumbs":[{"url":"https://help.kalshi.com/en/collections/18616613-markets","name":"Markets"},{"url":"https://help.kalshi.com/en/collections/18616615-popular-markets","name":"Popular Markets"}],"selectedReaction":null,"showReactions":true,"themeCSSCustomProperties":{"--body-bg":"rgb(255, 255, 255)","--body-image":"none","--body-bg-rgb":"255, 255, 255","--body-border":"rgb(230, 230, 230)","--body-primary-color":"#1a1a1a","--body-secondary-color":"#595959","--body-reaction-bg":"rgb(242, 242, 242)","--body-reaction-text-color":"rgb(89, 89, 89)","--body-toc-active-border":"#737373","--body-toc-inactive-border":"#f2f2f2","--body-toc-inactive-color":"#595959","--body-toc-active-font-weight":400,"--body-table-border":"rgb(204, 204, 204)","--body-color":"hsl(0, 0%, 0%)","--footer-bg":"rgb(247, 247, 247)","--footer-image":"none","--footer-border":"rgb(221, 221, 221)","--footer-color":"hsl(0, 0%, 46%)","--header-bg":"#FFFFFF","--header-image":"none","--header-color":"#191919","--collection-card-bg":"rgb(255, 255, 255)","--collection-card-image":"none","--collection-card-color":"hsl(160, 100%, 36%)","--card-bg":"transparent","--card-border-color":"transparent","--card-border-inner-radius":"8px","--card-border-radius":"8px","--card-shadow":"0 0 #0000","--search-bar-border-radius":"20px","--search-bar-width":"100%","--ticket-blue-bg-color":"#dce1f9","--ticket-blue-text-color":"#334bfa","--ticket-green-bg-color":"#d7efdc","--ticket-green-text-color":"#0f7134","--ticket-orange-bg-color":"#ffebdb","--ticket-orange-text-color":"#b24d00","--ticket-red-bg-color":"#ffdbdb","--ticket-red-text-color":"#df2020","--header-height":"405px","--header-subheader-backg