s="DocsSidebar_toggle___lsmG" aria-label="Expand Kalshi Social"><span class="DocsSidebar_chevron__QRtwS" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.1584 3.13508C6.35985 2.94621 6.67627 2.95642 6.86514 3.15788L10.6151 7.15788C10.7954 7.3502 10.7954 7.64949 10.6151 7.84182L6.86514 11.8418C6.67627 12.0433 6.35985 12.0535 6.1584 11.8646C5.95694 11.6757 5.94673 11.3593 6.1356 11.1579L9.565 7.49985L6.1356 3.84182C5.94673 3.64036 5.95694 3.32394 6.1584 3.13508Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg></span></button></div><div data-state="closed" id="radix-:Rombq6:" hidden="" class="DocsSidebar_collapse__DqzwW"><ul class="DocsSidebar_list__3oxkX"><li class="DocsSidebar_articleItem__AU_QA"><a class="DocsSidebar_link__nuWUw" title="How do I post, comment, and react on Kalshi Social?" href="https://help.kalshi.com/en/articles/15891130-how-do-i-post-comment-and-react-on-kalshi-social">How do I post, comment, and react on Kalshi Social?</a></li><li class="DocsSidebar_articleItem__AU_QA"><a class="DocsSidebar_link__nuWUw" title="Kalshi Social Community Guidelines" href="https://help.kalshi.com/en/articles/15891131-kalshi-social-community-guidelines">Kalshi Social Community Guidelines</a></li><li class="DocsSidebar_articleItem__AU_QA"><a class="DocsSidebar_link__nuWUw" title="How do I report or block someone on Kalshi Social?" href="https://help.kalshi.com/en/articles/15891132-how-do-i-report-or-block-someone-on-kalshi-social">How do I report or block someone on Kalshi Social?</a></li><li class="DocsSidebar_articleItem__AU_QA"><a class="DocsSidebar_link__nuWUw" title="What is Live Chat on Kalshi Social?" href="https://help.kalshi.com/en/articles/15891133-what-is-live-chat-on-kalshi-social">What is Live Chat on Kalshi Social?</a></li><li class="DocsSidebar_articleItem__AU_QA"><a class="DocsSidebar_link__nuWUw" title="What is Kalshi Social?" href="https://help.kalshi.com/en/articles/13823843-what-is-kalshi-social">What is Kalshi Social?</a></li><li class="DocsSidebar_articleItem__AU_QA"><a class="DocsSidebar_link__nuWUw" title="How do I edit my Kalshi Social profile?" href="https://help.kalshi.com/en/articles/13823773-how-do-i-edit-my-kalshi-social-profile">How do I edit my Kalshi Social profile?</a></li></ul></div></li></ul></div></aside></div><main id="docs-main" class="DocsShell_main__bquc5"><div class="DocsArticle_article__C1mpK" data-button-accent="primary" data-link-accent="primary"><nav class="DocsArticle_breadcrumbs__pASWu" aria-label="Breadcrumb"><a class="DocsArticle_crumbLink__S6a6m" href="/en/">All Collections</a><span class="DocsArticle_crumb__eHOzY"><span class="DocsArticle_crumbSep__RxsVH" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.1584 3.13508C6.35985 2.94621 6.67627 2.95642 6.86514 3.15788L10.6151 7.15788C10.7954 7.3502 10.7954 7.64949 10.6151 7.84182L6.86514 11.8418C6.67627 12.0433 6.35985 12.0535 6.1584 11.8646C5.95694 11.6757 5.94673 11.3593 6.1356 11.1579L9.565 7.49985L6.1356 3.84182C5.94673 3.64036 5.95694 3.32394 6.1584 3.13508Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg></span><a class="DocsArticle_crumbLink__S6a6m" href="https://help.kalshi.com/en/collections/18616613-markets">Markets</a></span><span class="DocsArticle_crumb__eHOzY"><span class="DocsArticle_crumbSep__RxsVH" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.1584 3.13508C6.35985 2.94621 6.67627 2.95642 6.86514 3.15788L10.6151 7.15788C10.7954 7.3502 10.7954 7.64949 10.6151 7.84182L6.86514 11.8418C6.67627 12.0433 6.35985 12.0535 6.1584 11.8646C5.95694 11.6757 5.94673 11.3593 6.1356 11.1579L9.565 7.49985L6.1356 3.84182C5.94673 3.64036 5.95694 3.32394 6.1584 3.13508Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg></span><a class="DocsArticle_crumbLink__S6a6m" href="https://help.kalshi.com/en/collections/18616615-popular-markets">Popular Markets</a></span><span class="DocsArticle_crumb__eHOzY" aria-current="page"><span class="DocsArticle_crumbSep__RxsVH" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.1584 3.13508C6.35985 2.94621 6.67627 2.95642 6.86514 3.15788L10.6151 7.15788C10.7954 7.3502 10.7954 7.64949 10.6151 7.84182L6.86514 11.8418C6.67627 12.0433 6.35985 12.0535 6.1584 11.8646C5.95694 11.6757 5.94673 11.3593 6.1356 11.1579L9.565 7.49985L6.1356 3.84182C5.94673 3.64036 5.95694 3.32394 6.1584 3.13508Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg></span><span class="DocsArticle_crumbCurrent__Jy3_j">Weather Markets</span></span></nav><header class="DocsArticle_header__le7BR"><h1 class="DocsArticle_title__3pXkn">Weather Markets</h1><div class="DocsArticle_metaRow__APlAp"><div class="DocsArticle_meta__4CRBq"><div class="avatar"><div class="avatar__info -mt-0.5 text-base"><span class="text-body-secondary-color"> <time dateTime="2026-07-22T21:48:23Z" title="Updated over 2 months ago">July 22, 2026</time></span></div></div></div><div class="DocsArticle_headerActions__u4fG_"><div class="DocsActionBar_bar__86vxW" role="group" aria-label="Article actions"><button type="button" class="DocsActionBar_btn__jbxkw"><span class="DocsActionBar_btnIcon__TRZws" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z"></path></svg></span>Copy for LLM</button><button type="button" class="DocsActionBar_caretBtn__KVQfJ" aria-label="More article actions" id="radix-:Rjdabq6:" aria-haspopup="menu" aria-expanded="false" data-state="closed"><span class="DocsActionBar_caret__pjMkD" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"></path></svg></span></button></div></div></div></header><div class="jsx-7b3ac4f8d5337043 article_body"><article class="jsx-7b3ac4f8d5337043 DocsArticleBody_body__BYuoi"><div class="intercom-interblocks-heading intercom-interblocks-align-left"><h1 id="h_3a878115eb">How do weather markets work?</h1></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Kalshi offers a wide variety of weather-related markets that allow users to trade contracts based on temperature movements or precipitation amounts in specific cities, from New York City to Los Angeles. Traders can take positions on whether a city will reach a certain high temperature or fall within a particular range. Each weather market names its official settlement source in its market rules. Daily high/low temperature markets settle based on the final climate report issued by the National Weather Service (NWS), typically released the following morning. Hourly temperature markets settle on readings from <a href="https://weather.com/kalshi" target="_blank" rel="nofollow noopener noreferrer">The Weather Company</a>. Always check the specific market’s rules for its source.</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-heading intercom-interblocks-align-left"><h1 id="h_13a85c056f">How Do I Trade on Weather Markets?</h1></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Kalshi creates a prediction market around a specific temperature threshold for a given location. For example: “Highest temperature in Chicago on April 15, 2025?”<br/>​<br/>Contract prices for temperature ranges may shift as new weather data (e.g., forecasts, model runs, satellite images, observations) becomes available.</p></div><div class="intercom-interblocks-callout" style="background-color:#feedaf80;border-color:#fbc91633"><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p><b>Note:</b> Not all weather data is the same. Apps like AccuWeather, iOS Weather, or Google Weather may be useful for guidance but do not determine contract outcomes. The only source used for settlement is the one named in the market’s rules - the NWS Daily Climate Report for daily temperature markets, or The Weather Company for hourly temperature markets.</p></div></div><div class="intercom-interblocks-subheading3 intercom-interblocks-align-left"><h3 id="h_e6219cfd03">Daily Temperature Markets</h3></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Daily weather markets are typically ranges: contracts resolve on the day’s highest (or lowest) temperature at the listed station, offered as a set of temperature ranges plus “or above” / “or below” levels.<br/>​</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>These markets settle the next morning based on the high temperature recorded in the final NWS Daily Climate Report. Market determination may be delayed in the rare instances of a) a high temperature is not consistent with 6-hr or 24-hr highs reported by METAR or b) the final NWS Climate Report high temperature value is lower than previous preliminary report.<br/>​</p></div><div class="intercom-interblocks-subheading3 intercom-interblocks-align-left"><h3 id="h_e3c3987fb7">Hourly Temperature Markets</h3></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Some temperature markets are hourly - the market title names an exact time, for example “Chicago temperature at 5 PM EDT.” These markets are also directional: each contract resolves on whether the temperature at that time is above or below a specific level, rather than within a range. They settle on the temperature at that exact time as reported by The Weather Company for the station coordinates named in the market rules (for example, KORD for Chicago).<br/>​</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>For these markets, The Weather Company’s reported value is official and final. NWS Climatological Reports, Google Weather, and other services may be useful references, but they are not authoritative for settlement. Preliminary Weather Company readings may differ from the final reported value due to rounding and conversion, so use caution when interpreting preliminary readings.<br/>​</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Settlement processes approximately 25-35 minutes after the market closes to ensure accurate data retrieval from the official source - a short delay after close is normal. Historical readings and market data are available at <a href="https://weather.com/kalshi" target="_blank" rel="nofollow noopener noreferrer">weather.com/kalshi</a>.<br/>​</p></div><div class="intercom-interblocks-subheading3 intercom-interblocks-align-left"><h3 id="h_43c2973c54">Daylight Savings Time</h3></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>The NWS Climate Reports (used for daily temperature markets) use local standard time when reporting daily high temperatures. This means that during Daylight Saving Time, the high temperature will be recorded between 1:00 AM and 12:59 AM local time the following day - not based on the standard midnight-to-midnight range.</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-subheading3 intercom-interblocks-align-left"><h3 id="h_b566fad15f">Finding Kalshi market&#x27;s relevant source information</h3></div><div class="intercom-interblocks-image intercom-interblocks-align-left"><a href="https://kalshi-62603e0948a4.intercom-attachments-7.com/i/o/wwha9iqh/2091381381/2b7de06f658363bda4a17396305d/spaces-2FmflMk4KOqMWpaeqpjOT5-2Fuploads-2FWcqIM6bL64oFXbx92woU-2Fimage-20%285%29.png-alt%3Dmedia-token%3D3974bec1-7307-4787-b609-cbf9ecddb0bd?expires=1790406000&amp;signature=e918a12466cf1f2776a79bf57757b63be2fd3dead12eda04990661260b330763&amp;req=diAuF8p2nIJXWPMW1HO4zYAoVEgnmd%2Fi9Ma1Gk%2BZzvbRn58G5OgY7kCAygY6%0A4%2BCyABDMpaNXN%2B%2Fscws%3D%0A" target="_blank" rel="noreferrer nofollow noopener"><img src="https://kalshi-62603e0948a4.intercom-attachments-7.com/i/o/wwha9iqh/2091381381/2b7de06f658363bda4a17396305d/spaces-2FmflMk4KOqMWpaeqpjOT5-2Fuploads-2FWcqIM6bL64oFXbx92woU-2Fimage-20%285%29.png-alt%3Dmedia-token%3D3974bec1-7307-4787-b609-cbf9ecddb0bd?expires=1790406000&amp;signature=e918a12466cf1f2776a79bf57757b63be2fd3dead12eda04990661260b330763&amp;req=diAuF8p2nIJXWPMW1HO4zYAoVEgnmd%2Fi9Ma1Gk%2BZzvbRn58G5OgY7kCAygY6%0A4%2BCyABDMpaNXN%2B%2Fscws%3D%0A" alt=""/></a></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p><i>Kalshi market for highest temp in NYC on March 17th, 2025.</i></p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>Here is an example of a weather market and how to find the relevant outcome (high temp). This example is for Mar 17, 2025 which was 59 degrees F. Above, you can see the Kalshi market and its determined outcome. Below, is the source data from the outcome verification source (linked in market rules).</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p> </p></div><div class="intercom-interblocks-image intercom-interblocks-align-left"><a href="https://kalshi-62603e0948a4.intercom-attachments-7.com/i/o/wwha9iqh/2091381393/6570c24f58bbade41b4961d5b133/spaces-2FmflMk4KOqMWpaeqpjOT5-2Fuploads-2Frl0VBfS51RV1dXDQBfbu-2FUntitled-20drawing-20%283%29.jpg-alt%3Dmedia-token%3De23e725d-23dd-4bb8-8a38-895fc972308a?expires=1790406000&amp;signature=006fa7741c245cb75988100831b26f6667788c0b99aeee77a466d5f7d20745fe&amp;req=diAuF8p2nIJWWvMW1HO4zcK36iCgz7oN%2B8It%2FPAV8AtvJiHmDex3k8X2G96R%0AB2iZabwPAV6lri80g0c%3D%0A" target="_blank" rel="noreferrer nofollow noopener"><img src="https://kalshi-62603e0948a4.intercom-attachments-7.com/i/o/wwha9iqh/2091381393/6570c24f58bbade41b4961d5b133/spaces-2FmflMk4KOqMWpaeqpjOT5-2Fuploads-2Frl0VBfS51RV1dXDQBfbu-2FUntitled-20drawing-20%283%29.jpg-alt%3Dmedia-token%3De23e725d-23dd-4bb8-8a38-895fc972308a?expires=1790406000&amp;signature=006fa7741c245cb75988100831b26f6667788c0b99aeee77a466d5f7d20745fe&amp;req=diAuF8p2nIJWWvMW1HO4zcK36iCgz7oN%2B8It%2FPAV8AtvJiHmDex3k8X2G96R%0AB2iZabwPAV6lri80g0c%3D%0A" alt=""/></a></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p><i>*Make sure you are viewing the temperature from the same date as the Kalshi market.</i><br/>​</p></div><div class="intercom-interblocks-paragraph no-margin intercom-interblocks-align-left"><p>For hourly temperature markets, the outcome source data is available at <a href="https://weather.com/kalshi" target="_blank" rel="nofollow noopener noreferrer">weather.com/kalshi</a>.</p></div></article></div><div class="DocsArticle_reactions__MwRj3"><fieldset class="DocsReactionPicker_picker__CfPZJ"><legend id=":R2abq6:" class="DocsReactionPicker_prompt__jhEmS">Did this answer your question?</legend><div class="DocsReactionPicker_options__8yUIr"><button type="button" class="DocsReactionPicker_reaction__hkJ7y" aria-labelledby=":R2abq6: :R2abq6:-disappointed" aria-pressed="false" data-reaction-text="disappointed"><span id=":R2abq6:-disappointed" class="sr-only">Disappointed Reaction</span><svg width="15" height="15" viewBox="0 0 15 15" fill="none" class="DocsReactionPicker_icon__BJFKu"><circle cx="7.5" cy="7.5" r="6" s