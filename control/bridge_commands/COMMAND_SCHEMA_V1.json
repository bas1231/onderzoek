{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PREDICTION_BRIDGE_COMMAND_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "action",
    "created_at_utc",
    "live_trading",
    "paid_actions",
    "wallet_actions",
    "intelligence_tier",
    "issuer"
  ],
  "properties": {
    "schema": {
      "const": "PREDICTION_BRIDGE_COMMAND_V1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "action": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,79}$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "route_task_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "live_trading": {
      "const": false
    },
    "paid_actions": {
      "const": false
    },
    "wallet_actions": {
      "const": false
    },
    "intelligence_tier": {
      "enum": ["A", "B", "C"]
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_level"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "reasoning_level": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
