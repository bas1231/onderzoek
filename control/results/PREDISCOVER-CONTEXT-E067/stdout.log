751:     def do_POST(self):
752:         path = urlparse(self.path).path
753: 
754:         if not self.authorized():
755:             self.send_json(401, {"error": "unauthorized"})
756:             return
757: 
758:         try:
759:             payload = self.read_json()
760: 
761:             with LOCK:
762:                 if path == "/discover":
763:                     task_id = str(
764:                         payload.get("task_id", "")
765:                     )
766: 
767:                     result = discover(task_id)
768: 
769:                     self.send_json(
770:                         200 if result.get("ok") else 400,
771:                         result,
772:                     )
773:                     return
774: 
775:                 if path == "/enqueue":
776:                     envelope = BridgeEnvelope.model_validate(payload)
777:                     result = enqueue(envelope)
778: 
779:                     self.send_json(
780:                         200 if result.get("ok") else 409,
781:                         result,
782:                     )
783:                     return
784: 
785:                 if path == "/ack":
786:                     task_id = str(payload.get("task_id", ""))
787:                     result = acknowledge(task_id)
788: 
789:                     self.send_json(
790:                         200 if result.get("ok") else 404,
791:                         result,
792:                     )
793:                     return
794: 
795:             self.send_json(404, {"error": "not found"})
796: 
797:         except Exception as exc:
798:             self.send_json(
799:                 400,
800:                 {
801:                     "error": type(exc).__name__,
802:                     "detail": str(exc),
803:                 },
804:             )
805: 
