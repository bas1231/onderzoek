LINE 92     function _reportOutcome(bytes32 _questionId, bool _outcome) internal {
LINE 93         bytes32 marketId = NegRiskIdLib.getMarketId(_questionId);
LINE 94         uint256 questionIndex = NegRiskIdLib.getQuestionIndex(_questionId);
LINE 95 
LINE 96         MarketData data = marketData[marketId];
LINE 97         address oracle = data.oracle();
LINE 98 
