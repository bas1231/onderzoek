  function resultMessage(item) {
    const compact = {
      task_id: item.task_id,
      result: item.result,
      stdout: (item.stdout || "").slice(0, 12000),
      stderr: (item.stderr || "").slice(0, 12000),
      git_head: item.git_head
    };

    return (
      RESULT_START +
