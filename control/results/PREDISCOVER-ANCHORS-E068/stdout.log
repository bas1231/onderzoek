33: class FileWrite(BaseModel):
34:     path: str
35:     content: str
36: 
37:     @field_validator("path")
38:     @classmethod
39:     def validate_path(cls, value: str) -> str:
40:         path = Path(value)
41: 
42:         if path.is_absolute():
43:             raise ValueError("absolute paths forbidden")
44: 
45:         if ".." in path.parts:
46:             raise ValueError("parent traversal forbidden")
47: 
48:         allowed = (
49:             "experiments/bridge/",
50:             "control/jobs/",
51:             "tests/bridge/",
52:         )
53: 
54:         text = path.as_posix()
55: 
56:         if not text.startswith(allowed):
57:             raise ValueError(
58:                 "bridge file writes restricted to "
59:                 "experiments/bridge/, control/jobs/, tests/bridge/"
60:             )
61: 
62:         return value
63: 
