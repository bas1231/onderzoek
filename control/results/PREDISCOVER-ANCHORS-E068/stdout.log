46:   async function isArmed() {
47:     const stored = await chrome.storage.local.get([
48:       "armedUrl",
49:       "armedProjectKey"
50:     ]);
51: 
52:     if (
53:       stored.armedUrl &&
54:       stored.armedUrl === normalizedCurrentUrl()
55:     ) {
56:       return true;
57:     }
58: 
59:     const currentProjectKey =
60:       projectKeyFromCurrentUrl();
61: 
62:     if (
63:       currentProjectKey &&
64:       stored.armedProjectKey &&
65:       currentProjectKey === stored.armedProjectKey
66:     ) {
67:       return true;
68:     }
69: 
70:     return false;
71:   }
