105:   function extractTaskBlocks(text) {
106:     const blocks = [];
107: 
108:     let position = 0;
109: 
110:     while (true) {
111:       const start = text.indexOf(
112:         TASK_START,
113:         position
114:       );
115: 
116:       if (start === -1) {
117:         break;
118:       }
119: 
120:       const contentStart =
121:         start + TASK_START.length;
122: 
123:       const end = text.indexOf(
124:         TASK_END,
125:         contentStart
126:       );
127: 
128:       if (end === -1) {
129:         break;
130:       }
131: 
132:       blocks.push(
133:         text.slice(contentStart, end).trim()
134:       );
135: 
136:       position = end + TASK_END.length;
137:     }
138: 
139:     return blocks;
140:   }
