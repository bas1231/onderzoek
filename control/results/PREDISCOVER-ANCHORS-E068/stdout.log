34:   function projectKeyFromCurrentUrl() {
35:     const parts = location.pathname
36:       .split("/")
37:       .filter(Boolean);
38: 
39:     const projectPart = parts.find(
40:       part => part.startsWith("g-p-")
41:     );
42: 
43:     return projectPart || "";
44:   }
