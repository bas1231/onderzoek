"proxy_wallet", "side", "token_id", "condition_id", "size", "price", "timestamp", "title", "slug", "icon", "event_slug", "outcome", "outcome_index", "name", "pseudonym", "bio", "profile_image", "profile_image_optimized", "transaction_hash"], "type": "object"}
