URL https://data-api.polymarket.com/v2/openapi.json
HTTP 200
CONTENT_TYPE application/json
BYTES 145041
OPENAPI_URL https://data-api.polymarket.com/v2/openapi.json
OPENAPI_VERSION 3.1.0
TRADE_OPERATION_SUMMARY List trades
TRADE_OPERATION_DESCRIPTION Keyset-paginated trade feed in the standard
`{ data, pagination }` envelope.

Pass `?cursor=` from a prior response's `next_cursor` to fetch the next page;
it carries both the page size and the `(block_timestamp, sequence_id)` seek
anchor, so deep pages cost the same as shallow ones.

A malformed `condition` id is a `400` naming the value; a
well-formed one that matches nothing serves an empty `data` array, which
is the meaningful zero-state; absence means the market is not servable,
and only that.
PARAM taker_only
PARAM_DESCRIPTION Defaults to `true`: each fill is served once, on its taker side.
`false` includes the maker rows too.
PARAM_SCHEMA {"type": ["boolean", "null"]}
PARAM condition
PARAM_DESCRIPTION Condition id(s), comma-separated (at most 20 distinct values).
`condition_id` / `conditionId` are accepted aliases.
PARAM_SCHEMA {"type": ["string", "null"]}
PARAM event_id
PARAM_DESCRIPTION Event id(s), comma-separated (at most 20 distinct values).
PARAM_SCHEMA {"type": ["string", "null"]}
PARAM side
PARAM_DESCRIPTION BUY or SELL.
PARAM_SCHEMA {"type": ["string", "null"]}
RESPONSE_200 {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/TradesPage"}}}, "description": "A page of trades"}
SCHEMA_NAME Activity
SCHEMA_BODY {"description": "One activity-feed event (`/v2/activity`); a trade, split, merge, redeem, \u2026", "properties": {"bio": {"description": "Profile bio text.", "type": "string"}, "condition_id": {"description": "On-chain condition id of the market (`0x` hex).", "type": "string"}, "event_slug": {"description": "Parent event slug.", "type": "string"}, "icon": {"description": "Market icon URL.", "type": "string"}, "is_combo": {"description": "Flag only, on V2/V3 combo trade rows. Combo detail lives on the combos\nendpoints; omitted from non-combo rows.", "type": "boolean"}, "name": {"description": "Profile display name of the wallet.", "type": "string"}, "outcome": {"description": "Label of the outcome (e.g. `Yes`).", "type": "string"}, "outcome_index": {"description": "Index of the outcome within the market; `999` means the outcome\ncould not be labeled.", "format": "int32", "type": "integer"}, "price": {"description": "Price per share in USDC (trades; `0` where no price applies).", "format": "double", "type": "number"}, "profile_image": {"description": "Profile image URL.", "type": "string"}, "profile_image_optimized": {"description": "Resized profile image URL, when one exists.", "type": "string"}, "proxy_wallet": {"description": "Proxy wallet the row belongs to; the address every wallet-keyed\nendpoint accepts as `user`.", "type": "string"}, "pseudonym": {"description": "Generated fallback handle for profiles without a display name.", "type": "string"}, "side": {"description": "`BUY` or `SELL` on trade rows, from this wallet's perspective; empty\nwhere a side does not apply.", "type": "string"}, "size": {"description": "Share quantity of the action; bare sizes are shares, never USD.", "format": "double", "type": "number"}, "slug": {"description": "Market slug; the URL segment on polymarket.com.", "type": "string"}, "timestamp": {"description": "Block timestamp of the action, epoch seconds.", "format": "int64", "type": "integer"}, "title": {"description": "Market question title (Gamma enrichment; empty when unenriched).", "type": "string"}, "token_id": {"description": "CLOB asset id of the outcome token the action touched.", "type": "string"}, "transaction_hash": {"description": "Hash of the settling transaction.", "type": "string"}, "type": {"description": "TRADE, SPLIT, MERGE, REDEEM, REWARD, CONVERSION, \u2026", "type": "string"}, "usdc_size": {"description": "Cash value of the action in USDC.", "format": "double", "type": "number"}}, "required": ["proxy_wallet", "timestamp", "condition_id", "type", "size", "usdc_size", "transaction_hash", "price", "token_id", "side", "outcome_index", "title", "slug", "icon", "event_slug", "outcome", "name", "pseudonym", "bio", "profile_image", "profile_image_optimized"], "type": "object"}
SCHEMA_NAME Holder
SCHEMA_BODY {"description": "One `/v2/holders` row: a market holder enriched with their public profile,\nnetted across the market's outcome tokens by default or at per-side gross\ngrain with the position economics when `include_pnl=true`.\n`profile_image_optimized` is always empty.", "properties": {"amount": {"description": "Holding in shares. By default the NET figure (a fully hedged wallet\nnets to `0.0` and only appears at `min_balance=0`); with\n`include_pnl=true` the per-side GROSS figure, so each side of a hedged\nwallet appears under its own token with that side's full size.", "format": "double", "type": "number"}, "avg_price": {"description": "Historical entry price per share. Served only with `include_pnl=true`.", "format": "double", "type": ["number", "null"]}, "bio": {"description": "Profile bio text.", "type": "string"}, "current_price": {"description": "Current price of the held outcome token, bounded to `[0, 1]`. Served\nonly with `include_pnl=true`.", "format": "double", "type": ["number", "null"]}, "current_value": {"description": "Mark value of the holding: `amount` times `current_price`. Served only\nwith `include_pnl=true`.", "format": "double", "type": ["number", "null"]}, "display_username_public": {"description": "Whether the profile chose to show its name publicly.", "type": "boolean"}, "entry_cost_usdc": {"description": "Cost basis of the held size in USDC, excluding entry fees. Served only\nwith `include_pnl=true`.", "format": "double", "type": ["number", "null"]}, "name": {"description": "Profile display name of the wallet.", "type": "string"}, "outcome_index": {"description": "Index of the held outcome within the market; `999` means unlabelable.", "format": "int32", "type": "integer"}, "profile_image": {"description": "Profile image URL.", "type": "string"}, "profile_image_optimized": {"description": "Resized profile image URL, when one exists.", "type": "string"}, "proxy_wallet": {"description": "The holding wallet.", "type": "string"}, "pseudonym": {"description": "Generated fallback handle for profiles without a display name.", "type": "string"}, "realized_pnl": {"description": "Profit already locked in by sells and redemptions. Served only with\n`include_pnl=true`.", "format": "double", "type": ["number", "null"]}, "token_id": {"description": "Outcome token held.", "type": "string"}, "total_pnl": {"description": "Total profit and loss; always `realized_pnl + unrealized_pnl`. Served\nonly with `include_pnl=true`.", "format": "double", "type": ["number", "null"]}, "unrealized_pnl": {"description": "Mark-to-market profit on the held size: `current_value` minus\n`entry_cost_usdc`. Served only with `include_pnl=true`.", "format": "double", "type": ["number", "null"]}, "verified": {"description": "Profile verification badge.", "type": "boolean"}}, "required": ["proxy_wallet", "bio", "token_id", "pseudonym", "amount", "display_username_public", "outcome_index", "name", "profile_image", "profile_image_optimized", "verified"], "type": "object"}
SCHEMA_NAME MetaHolder
SCHEMA_BODY {"description": "One outcome token's holder group in `/v2/holders`: the `token_id` and its\nholders, top-N by net balance. A multi-market request interleaves tokens\nacross the page, so merge groups by `token_id`, not by array position.", "properties": {"holders": {"description": "Top holders of that token, amount descending (net by default,\nper-side gross with `include_pnl=true`).", "items": {"$ref": "#/components/schemas/Holder"}, "type": "array"}, "token_id": {"description": "The outcome token this group ranks.", "type": "string"}}, "required": ["token_id", "holders"], "type": "object"}
SCHEMA_NAME Position
SCHEMA_BODY {"description": "One position (`/v2/positions`); a holding in a single outcome token, priced\nand enriched.\n\nThe shape is **uniform across all three arms** (user OPEN/REDEEMABLE, user\nCLOSED, market-anchored): clients never branch on which spine answered. On\nthe CLOSED arm `current_size`/`current_value`/`unrealized_pnl` are ~0 by construction, which is exactly\nwhat a closed position should report.\n\nKeyset-paginated on the active `sort_by` key: follow the response's\n`next_cursor` to page, and expect the ordering to change with `sort_by`.", "properties": {"archived": {"description": "Whether the market is archived; tells a caller using `includeArchived`\nwhich rows the flag surfaced.", "type": "boolean"}, "avg_price": {"description": "Weighted-average entry price per share, in USDC.", "format": "double", "type": "number"}, "condition_id": {"description": "The on-chain condition id.", "type": "string"}, "current_price": {"description": "Live mark per share, in USDC.", "format": "double", "type": "number"}, "current_size": {"description": "The CURRENT holding, in shares (~0 residual on the CLOSED arm).", "format": "double", "type": "number"}, "current_value": {"description": "`current_size \u00d7 current_price`, in USDC.", "format": "double", "type": "number"}, "end_date": {"description": "Market end date, `YYYY-MM-DD`; `1970-01-01` when Gamma has none.", "type": "string"}, "entry_cost_usdc": {"description": "The fee-EXCLUSIVE entry basis.", "format": "double", "type": "number"}, "entry_fees_usdc": {"description": "Attributed BUY-fee total for the position. Disclosure only:\n`entry_cost_usdc` is already fee-exclusive, so never re-deduct this\nfrom a PnL column.", "format": "double", "type": "number"}, "event_id": {"description": "Gamma event id of the parent event.", "type": "string"}, "event_slug": {"description": "Parent event slug.", "type": "string"}, "icon": {"description": "Market icon URL.", "type": "string"}, "last_event_at": {"description": "The row's last economics event, epoch seconds; 0 without native state.", "format": "int64", "type": "integer"}, "mergeable": {"description": "Whether the wallet also holds the opposite outcome, so the pair can\nmerge back into collateral.", "type": "boolean"}, "name": {"description": "Profile display name of the wallet.", "type": "string"}, "negative_risk": {"description": "Whether the market belongs to a neg-risk group.", "type": "boolean"}, "opposite_outcome": {"description": "Label of the market's other outcome; what a merge pairs with.", "type": "string"}, "opposite_token_id": {"description": "Token id of the market's other outcome.", "type": "string"}, "outcome": {"description": "Label of the held outcome (e.g. `Yes`).", "type": "string"}, "outcome_index": {"description": "Index of the held outcome within the market; `999` means the outcome\ncould not be labeled.", "format": "int32", "type": "integer"}, "percent_pnl": {"description": "`(current_value - entry_cost_usdc) / entry_cost_usdc`, as a percent.\nFee-exclusive basis, and the numerator is `unrealized_pnl`; not\n`total_pnl / total_cost_usdc`.", "format": "double", "type": "number"}, "percent_realized_pnl": {"description": "`(current_value - total_size \u00d7 avg_price) / (total_size \u00d7 avg_price)`,\nas a percent. A compatibility shape: despite the name, it is not\n`realized_pnl` over a basis.", "format": "double", "type": "number"}, "profile_image": {"description": "Profile image URL.", "type": "string"}, "proxy_wallet": {"description": "Proxy wallet holding the position.", "type": "string"}, "realized_pnl": {"description": "Realized PnL in USDC, cumulative for the position.", "format": "double", "type": "number"}, "redeemable": {"description": "Whether the position can be redeemed now: its market resolved and the\ntokens are still held (losing sides included; redeemable \u2260 won).", "type": "boolean"}, "slug": {"description": "Market slug; the URL segment on polymarket.com.", "type": "string"}, "status": {"description": "The row's actual state; can be narrower than the requested `status`,\nsince an `OPEN` request also returns `REDEEMABLE` rows.", "type": "string"}, "title": {"description": "Market question title (Gamma enrichment; empty when unenriched).", "type": "string"}, "token_id": {"description": "The outcome token id.", "type": "string"}, "total_cost_usdc": {"description": "Gross (fee-INCLUSIVE) basis. Always exactly\n`entry_cost_usdc + entry_fees_usdc`; the contract sums the two served\ncolumns, so the identity holds on every row of every arm.", "format": "double", "type": "number"}, "total_pnl": {"description": "Always equals `realized_pnl + unrealized_pnl`.", "format": "double", "type": "number"}, "total_size": {"description": "LIFETIME bought shares (the WAC denominator), never the\ncurrent balance; that is `current_size`.", "format": "double", "type": "number"}, "unrealized_pnl": {"description": "Unrealized (mark-to-market) PnL: `current_value - entry_cost_usdc`.", "format": "double", "type": "number"}, "verified": {"description": "Profile verification badge.", "type": "boolean"}}, "required": ["proxy_wallet", "token_id", "condition_id", "current_size", "avg_price", "entry_cost_usdc", "entry_fees_usdc", "total_cost_usdc", "current_price", "current_value", "total_size", "realized_pnl", "unrealized_pnl", "total_pnl", "percent_pnl", "percent_realized_pnl", "status", "redeemable", "mergeable", "negative_risk", "archived", "title", "slug", "icon", "event_id", "event_slug", "outcome", "outcome_index", "opposite_outcome", "opposite_token_id", "end_date", "last_event_at", "name", "profile_image", "verified"], "type": "object"}
SCHEMA_NAME Trade
