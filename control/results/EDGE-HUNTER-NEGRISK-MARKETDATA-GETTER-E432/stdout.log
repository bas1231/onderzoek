LINE 91     /// @notice Reverts if the outcome is true, and the market has already been determined
LINE 92     function _reportOutcome(bytes32 _questionId, bool _outcome) internal {
LINE 93         bytes32 marketId = NegRiskIdLib.getMarketId(_questionId);
LINE 94         uint256 questionIndex = NegRiskIdLib.getQuestionIndex(_questionId);
LINE 95 
LINE 96         MarketData data = marketData[marketId];
LINE 97         address oracle = data.oracle();
LINE 98 
LINE 99         if (oracle == address(0)) revert MarketNotPrepared();
LINE 100         if (oracle != msg.sender) revert OnlyOracle();
LINE 101         if (questionIndex >= data.questionCount()) revert IndexOutOfBounds();
LINE 102 
LINE 103         if (_outcome == true) {
LINE 104             if (data.determined()) revert MarketAlreadyDetermined();
LINE 105             marketData[marketId] = data.determine(questionIndex);
MATCH_END
