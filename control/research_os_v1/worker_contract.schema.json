{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-os-v1-worker-contract",
  "title": "Research OS V1 Worker Task/Result Contract",
  "type": "object",
  "required": ["task_id", "worker_domain", "objective", "state", "task_shape", "inputs", "constraints", "expected_output", "scheduling", "proposed_action"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "candidate_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "legacy_role": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "legacy_status": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "worker_domain": {"enum": ["discovery", "market_research", "mechanics", "algebra", "red_team", "research_director", "independent_reproducer"]},
    "objective": {"type": "string", "minLength": 1},
    "decisive_question": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "state": {"enum": ["READY", "WAITING_FOR_DATA", "WAITING_FOR_RESULT", "PARKED", "BLOCKED"]},
    "task_shape": {
      "type": "object",
      "required": ["parallelism", "dependency_shape", "uncertainty_type", "time_sensitivity", "novelty", "decision_relevance"],
      "properties": {
        "parallelism": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "dependency_shape": {"enum": ["INDEPENDENT", "PARTIAL", "SEQUENTIAL"]},
        "uncertainty_type": {"enum": ["SOURCE", "SEMANTIC", "MECHANISM", "SIGNAL", "MARKET", "EXECUTION", "ROBUSTNESS", "PROCESS"]},
        "time_sensitivity": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "novelty": {"enum": ["DUPLICATE", "INCREMENTAL", "NOVEL"]},
        "decision_relevance": {"enum": ["LOW", "MEDIUM", "HIGH", "DECISIVE"]}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rule_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "negative_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "failure_pattern_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "candidate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "routed_evidence_count": {"type": "integer", "minimum": 0},
        "point_in_time_cutoff": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "required": ["live_trading", "paid_actions", "wallet_actions", "source_policy"],
      "properties": {
        "live_trading": {"const": false},
        "paid_actions": {"const": false},
        "wallet_actions": {"const": false},
        "source_policy": {"enum": ["FREE_PUBLIC_ONLY", "LOCAL_EXISTING_ONLY"]},
        "blind_to_origin_reasoning": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expected_output": {
      "type": "object",
      "required": ["artifact_type", "required_fields"],
      "properties": {
        "artifact_type": {"enum": ["DISCOVERY_FINDING", "RESEARCH_FINDING", "FALSIFICATION", "REPRODUCTION", "DIRECTOR_DECISION"]},
        "required_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "scheduling": {
      "type": "object",
      "required": ["uncertainty_reduction", "dependency_unlock_value", "evidence_cost", "model_cost", "duplication_risk"],
      "properties": {
        "uncertainty_reduction": {"enum": ["LOW", "MEDIUM", "HIGH", "DECISIVE"]},
        "dependency_unlock_value": {"enum": ["NONE", "ONE", "MULTIPLE"]},
        "evidence_cost": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "model_cost": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "duplication_risk": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      },
      "additionalProperties": false
    },
    "proposed_action": {
      "type": "object",
      "required": ["kind", "provenance", "point_in_time"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "provenance": {"type": "boolean"},
        "point_in_time": {"type": "boolean"},
        "branch": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "contains_secrets": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["task_id", "worker_domain", "status", "claims", "evidence", "contradictions", "unknowns", "gate_effect", "economic_conclusion"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "candidate_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "worker_domain": {"enum": ["discovery", "market_research", "mechanics", "algebra", "red_team", "research_director", "independent_reproducer"]},
        "status": {"enum": ["COMPLETE", "BLOCKED", "FAILED", "NO_NEW_EVIDENCE"]},
        "claims": {"type": "array", "items": {"type": "object"}},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["point_in_time_status"],
            "properties": {
              "source_ref": {"type": "string", "minLength": 1},
              "evidence_ref": {"type": "string", "minLength": 1},
              "ref": {"type": "string", "minLength": 1},
              "content_hash": {"type": "string", "minLength": 1},
              "document_sha256": {"type": "string", "minLength": 1},
              "point_in_time_status": {"enum": ["PASS", "FAIL", "PENDING", "UNKNOWN", "NOT_APPLICABLE"]}
            },
            "anyOf": [
              {"required": ["source_ref"]},
              {"required": ["evidence_ref"]},
              {"required": ["ref"]},
              {"required": ["content_hash"]},
              {"required": ["document_sha256"]}
            ],
            "additionalProperties": true
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["point_in_time_status"],
            "properties": {
              "source_ref": {"type": "string", "minLength": 1},
              "evidence_ref": {"type": "string", "minLength": 1},
              "ref": {"type": "string", "minLength": 1},
              "content_hash": {"type": "string", "minLength": 1},
              "document_sha256": {"type": "string", "minLength": 1},
              "point_in_time_status": {"enum": ["PASS", "FAIL", "PENDING", "UNKNOWN", "NOT_APPLICABLE"]}
            },
            "anyOf": [
              {"required": ["source_ref"]},
              {"required": ["evidence_ref"]},
              {"required": ["ref"]},
              {"required": ["content_hash"]},
              {"required": ["document_sha256"]}
            ],
            "additionalProperties": true
          }
        },
        "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "gate_effect": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gate", "state"],
            "properties": {
              "gate": {"type": "string", "minLength": 1},
              "state": {"enum": ["PASS", "FAIL", "PENDING", "UNKNOWN", "NOT_APPLICABLE"]},
              "basis_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "allOf": [
              {
                "if": {"properties": {"state": {"enum": ["PASS", "FAIL"]}}, "required": ["state"]},
                "then": {"required": ["basis_refs"], "properties": {"basis_refs": {"minItems": 1}}}
              }
            ],
            "additionalProperties": true
          }
        },
        "failure_patterns_triggered": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "next_decisive_test": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "source_independence": {"enum": ["UNKNOWN", "SHARED_UPSTREAM", "PARTIAL", "INDEPENDENT", "NOT_APPLICABLE"]},
        "economic_conclusion": {"enum": ["NO_PROVEN_EDGE", "RESEARCH_POSITIVE", "TESTED_NEGATIVE", "EXECUTION_BLOCKED", "STRUCTURAL_CANDIDATE"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
