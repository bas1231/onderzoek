{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-os-v1-worker-contract",
  "title": "Research OS V1 Worker Task/Result Contract",
  "type": "object",
  "required": ["task_id", "worker_domain", "objective", "task_shape", "inputs", "constraints", "expected_output"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": ["string", "null"]},
    "worker_domain": {"enum": ["discovery", "market_research", "mechanics", "algebra", "red_team", "research_director", "independent_reproducer"]},
    "objective": {"type": "string", "minLength": 1},
    "decisive_question": {"type": ["string", "null"]},
    "task_shape": {
      "type": "object",
      "required": ["parallelism", "dependency_shape", "uncertainty_type", "decision_relevance"],
      "properties": {
        "parallelism": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "dependency_shape": {"enum": ["INDEPENDENT", "PARTIAL", "SEQUENTIAL"]},
        "uncertainty_type": {"enum": ["SOURCE", "SEMANTIC", "MECHANISM", "SIGNAL", "MARKET", "EXECUTION", "ROBUSTNESS", "PROCESS"]},
        "time_sensitivity": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "novelty": {"enum": ["DUPLICATE", "INCREMENTAL", "NOVEL"]},
        "decision_relevance": {"enum": ["LOW", "MEDIUM", "HIGH", "DECISIVE"]}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "claim_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "rule_refs": {"type": "array", "items": {"type": "string"}},
        "negative_evidence_refs": {"type": "array", "items": {"type": "string"}},
        "failure_pattern_ids": {"type": "array", "items": {"type": "string"}},
        "point_in_time_cutoff": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "required": ["live_trading", "paid_actions", "wallet_actions"],
      "properties": {
        "live_trading": {"const": false},
        "paid_actions": {"const": false},
        "wallet_actions": {"const": false},
        "source_policy": {"enum": ["FREE_PUBLIC_ONLY", "LOCAL_EXISTING_ONLY"]},
        "blind_to_origin_reasoning": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "expected_output": {
      "type": "object",
      "required": ["artifact_type", "required_fields"],
      "properties": {
        "artifact_type": {"enum": ["DISCOVERY_FINDING", "RESEARCH_FINDING", "FALSIFICATION", "REPRODUCTION", "DIRECTOR_DECISION"]},
        "required_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "result": {
      "type": "object",
      "required": ["status", "claims", "evidence", "contradictions", "unknowns", "gate_effect", "economic_conclusion"],
      "properties": {
        "status": {"enum": ["COMPLETE", "BLOCKED", "FAILED", "NO_NEW_EVIDENCE"]},
        "claims": {"type": "array", "items": {"type": "object"}},
        "evidence": {"type": "array", "items": {"type": "object"}},
        "contradictions": {"type": "array", "items": {"type": "object"}},
        "unknowns": {"type": "array", "items": {"type": "string"}},
        "gate_effect": {"type": "array", "items": {"type": "object"}},
        "failure_patterns_triggered": {"type": "array", "items": {"type": "string"}},
        "next_decisive_test": {"type": ["string", "null"]},
        "source_independence": {"enum": ["UNKNOWN", "SHARED_UPSTREAM", "PARTIAL", "INDEPENDENT", "NOT_APPLICABLE"]},
        "economic_conclusion": {"enum": ["NO_PROVEN_EDGE", "RESEARCH_POSITIVE", "TESTED_NEGATIVE", "EXECUTION_BLOCKED", "STRUCTURAL_CANDIDATE"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
