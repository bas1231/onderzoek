    {"id":"GOV-002","match":"paid_action","decision":"BLOCK_USER_APPROVAL","requirements":["specific_action_approval"]},
    {"id":"GOV-003","match":"live_order_or_trade","decision":"BLOCK_USER_APPROVAL","requirements":["specific_action_approval"]},
    {"id":"GOV-004","match":"wallet_or_fund_movement","decision":"BLOCK_USER_APPROVAL","requirements":["specific_action_approval"]},
    {"id":"GOV-005","match":"credential_mutation_or_secret_export","decision":"BLOCK","requirements":[]},
    {"id":"GOV-006","match":"unauthorized_access_fraud_deception_manipulation_or_active_security_exploitation","decision":"BLOCK","requirements":[]},
    {"id":"GOV-007","match":"post_close_or_later_revision_backfill_into_point_in_time_decision","decision":"BLOCK","requirements":[]},
    {"id":"GOV-008","match":"delete_negative_evidence_to_strengthen_thesis","decision":"BLOCK","requirements":[]},
